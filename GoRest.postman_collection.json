                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var resData = pm.response.json();",
                  "pm.collectionVariables.set(\"user_id\", resData.id);",
                  "pm.collectionVariables.set(\"user_email\", resData.email);"
                ]
